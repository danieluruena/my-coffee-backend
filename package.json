{
  "name": "my-coffee-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "sam build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "jest --config jest.config.cjs",
    "sam:validate": "sam validate --lint",
    "local:up": "docker compose up -d --wait",
    "local:down": "docker compose down",
    "local:setup": "tsx scripts/local/setup.ts",
    "local:seed": "tsx scripts/local/seed.ts",
    "sam:local": "npm run build && sam local start-api --env-vars .env.local.json --parameter-overrides Env=local"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieluruena/my-coffee-backend.git"
  },
